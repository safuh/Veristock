APP_NAME=Veristock
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
ALLOW_SELF_REGISTRATION=false
JWT_SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
DATABASE_URL=sqlite+aiosqlite:///./backbone.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
LOG_LEVEL=INFO
LOG_JSON=false
# Generate a unique high-entropy JWT_SECRET_KEY for each environment. Never commit it.

# Optional AI narrative provider. Leave AI_PROVIDER unset to disable external AI calls.
# OpenAI-compatible endpoints include Ollama (http://localhost:11434/v1) and gateways.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=your-model-name
# AI_API_KEY=
# AI_TIMEOUT_SECONDS=20
