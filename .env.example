APP_NAME=Veristock
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
ALLOW_SELF_REGISTRATION=false
DATABASE_URL=sqlite+aiosqlite:///./backbone.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
LOG_LEVEL=INFO
LOG_JSON=false
# Access-token validation is injected as TokenService by the deployment composition root.
# The token issuer and validator must use the same high-entropy secret and algorithm.
